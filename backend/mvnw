#!/bin/sh
DIRNAME=`dirname "$0"`
WRAPPER_JAR="$DIRNAME/.mvn/wrapper/maven-wrapper.jar"

if [ ! -d "$DIRNAME/.mvn/wrapper" ]; then
    mkdir -p "$DIRNAME/.mvn/wrapper"
fi

if [ ! -f "$WRAPPER_JAR" ]; then
    echo "Downloading Maven wrapper jar..."
    curl -sSLo "$WRAPPER_JAR" https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.2.0/maven-wrapper-3.2.0.jar || wget -q -O "$WRAPPER_JAR" https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.2.0/maven-wrapper-3.2.0.jar
fi

exec java "-Dmaven.multiModuleProjectDirectory=$DIRNAME" -classpath "$WRAPPER_JAR" org.apache.maven.wrapper.MavenWrapperMain "$@"
